                <zone forceUpdate='true' h='1731' id='25' type-v2='text' w='97143' x='1429' y='15000'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontname='Helvetica' fontsize='24'>From pole, how often do the wins come?</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
