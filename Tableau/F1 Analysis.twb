      </column>
      <column caption='Pole Result' datatype='string' name='[Calculation_2442891446312960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pole_won] = 1 THEN &quot;Pole won&quot; ELSE &quot;Someone else won&quot; END' />
      </column>
      <column caption='Ring Label' datatype='string' name='[Calculation_2442891451125765]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(AVG([pole_won])*100,0)) + &quot;%&quot;' />
      </column>
      <column caption='Pole Won Matched' datatype='integer' name='[Calculation_2442891467288582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([pole_p_base]) THEN [pole_won] END' />
      </column>
      <column caption='Baseline Expected' datatype='real' name='[Calculation_2442891470082055]' role='measure' type='quantitative'>
