        <zone h='6923' id='9' name='KPI Races' show-title='false' w='22857' x='74286' y='5769' />
        <zone forceUpdate='true' h='1923' id='12' type-v2='text' w='78929' x='19643' y='1154'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Helvetica' fontsize='36'>How much does Saturday tell us about Sunday?</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='1538' id='13' type-v2='text' w='78929' x='19643' y='3462'>
          <formatted-text>
            <run fontcolor='#ffffff' fontname='Helvetica' fontsize='16' italic='true'>Does F1 qualifying tell us anything beyond the car and the team? 329 races, 2010 to 2025.</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='6731' id='18' is-scaled='1' param='/Users/oj/Downloads/formula-1-vector-logo-seeklogo/formula-1-seeklogo.png' type-v2='bitmap' w='14286' x='1429' y='0' />
        <zone forceUpdate='true' h='1731' id='25' type-v2='text' w='97143' x='1429' y='15000'>
          <formatted-text>
            <run bold='true' fontcolor='#e6e6e6' fontname='Helvetica' fontsize='24' underline='true'>How often does the driver on pole actually win?</run>
          </formatted-text>
        </zone>
        <zone h='14615' id='26' name='Pole Ring' show-title='false' w='27143' x='1429' y='19231' />
        <zone h='18462' id='31' name='Pole By Year' show-title='false' w='60714' x='30714' y='17308' />
        <zone h='2692' id='32' type-v2='text' w='97143' x='1429' y='36538'>
          <formatted-text>
            <run fontcolor='#e6e6e6' fontname='Helvetica' fontsize='14' italic='true'>The driver on pole won 172 of 329 races (52%). The red bars show each season&apos;s share. The dashed line is the overall average, and with only 16 to 24 races a year, much of the swing is luck.</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='1731' id='35' type-v2='text' w='97143' x='1429' y='39615'>
          <formatted-text>
            <run bold='true' fontcolor='#e6e6e6' fontname='Benton Sans Book' fontsize='24' underline='true'>How often would we expect them to win before qualifying?</run>
          </formatted-text>
        </zone>
        <zone h='20000' id='36' name='Gap Dumbbell Lines' show-title='false' w='97143' x='1429' y='41923' />
        <zone forceUpdate='true' h='3077' id='37' type-v2='text' w='97143' x='1429' y='62308'>
          <formatted-text>
            <run fontcolor='#e6e6e6' fontname='Helvetica' fontsize='14' italic='true'>From car and driver alone, the pole-sitter was expected to win about 22% of the time (grey). They actually won 53% (red, which skips the 3 races with nobody on grid slot 1, so it sits slightly above the 52% above). The gap is what Saturday adds.</run>
          </formatted-text>
        </zone>
      </zones>
