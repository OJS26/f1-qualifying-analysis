      </column>
      <column caption='Plausible Winners Before' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5486545433587712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='EXP(AVG([loss_base]))' />
      </column>
      <column caption='Plausible Winners After' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5486545433788417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='EXP(AVG([loss_grid]))' />
      </column>
      <column caption='Winner Chance Before' datatype='real' name='[Calculation_5486545433845762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='EXP(-AVG([loss_base]))' />
