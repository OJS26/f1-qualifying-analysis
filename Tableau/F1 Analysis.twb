      <column caption='Pole Result' datatype='string' name='[Calculation_2442891446312960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pole_won] = 1 THEN &quot;Pole won&quot; ELSE &quot;Someone else won&quot; END' />
      </column>
      <column caption='Ring Label' datatype='string' name='[Calculation_2442891451125765]' role='measure' type='nominal'>
