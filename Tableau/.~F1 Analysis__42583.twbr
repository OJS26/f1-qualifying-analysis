      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1wdm7i91w5j1k214jgw2p1celige].[usr:Calculation_5486545433587712:qk]&quot;' value='Before the Grid' />
          <alias key='&quot;[federated.1wdm7i91w5j1k214jgw2p1celige].[usr:Calculation_5486545433788417:qk]&quot;' value='After the Grid' />
        </aliases>
      </column>
      <column caption='KPI Pole' datatype='string' name='[Calculation_1665949024477184]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(AVG([pole_won])*100,0)) + &quot;%&quot;' />
      </column>
      <column caption='KPI Races' datatype='string' name='[Calculation_1665949025648641]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(COUNTD([race_id]))' />
      </column>
      <column caption='Pole Result' datatype='string' name='[Calculation_2442891446312960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pole_won] = 1 THEN &quot;Pole won&quot; ELSE &quot;Someone else won&quot; END' />
      </column>
      <column caption='Ring Label' datatype='string' name='[Calculation_2442891451125765]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(AVG([pole_won])*100,0)) + &quot;%&quot;' />
      </column>
      <column caption='Pole Won Matched' datatype='integer' name='[Calculation_2442891467288582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([pole_p_base]) THEN [pole_won] END' />
      </column>
      <column caption='Baseline Expected' datatype='real' name='[Calculation_2442891470082055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([pole_p_base])' />
      </column>
      <column caption='Pole Actual' datatype='real' name='[Calculation_2442891470229512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_2442891467288582])' />
      </column>
      <column caption='KPI Gap' datatype='string' name='[Calculation_5079590054150144]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;+&quot; + STR(ROUND((AVG([Calculation_2442891467288582]) - AVG([pole_p_base]))*100,0))' />
      </column>
      <column caption='Plausible Winners Before' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5486545433587712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='EXP(AVG([loss_base]))' />
      </column>
      <column caption='Plausible Winners After' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5486545433788417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='EXP(AVG([loss_grid]))' />
      </column>
      <column caption='Winner Chance Before' datatype='real' name='[Calculation_5486545433845762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='EXP(-AVG([loss_base]))' />
      </column>
      <column caption='Winner Chance After' datatype='real' name='[Calculation_5486545433911299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='EXP(-AVG([loss_grid]))' />
      </column>
      <column caption='KPI Winners' datatype='string' name='[Calculation_5486545434533892]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Calculation_5486545433587712],0)) + &quot; → &quot; + STR(ROUND([Calculation_5486545433788417],0))' />
      </column>
      <column caption='KPI Chance' datatype='string' name='[Calculation_5486545465712645]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Calculation_5486545433845762]*100,0)) + &quot;% → &quot; + STR(ROUND([Calculation_5486545433911299]*100,0)) + &quot;%&quot;' />
      </column>
      <column caption='Season type' datatype='string' name='[Calculation_6390757686784000]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [dominant_season] THEN &quot;Runaway seasons&quot; ELSE &quot;Close seasons&quot; END' />
      </column>
      <column caption='KPI Drop' datatype='string' name='[Calculation_6390757731536897]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(EXP(AVG(IF NOT [dominant_season] THEN [loss_base] END)) - EXP(AVG(IF NOT [dominant_season] THEN [loss_grid] END)),1)) + &quot; vs &quot; + STR(ROUND(EXP(AVG(IF [dominant_season] THEN [loss_base] END)) - EXP(AVG(IF [dominant_season] THEN [loss_grid] END)),1))' />
      </column>
      <column caption='Card Title' datatype='string' name='[Calculation_6390757754277890]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([circuit_name]) = 1 THEN MIN([circuit_name]) ELSE &quot;All circuits&quot; END' />
      </column>
      <column caption='Card Races' datatype='string' name='[Calculation_6390757754351619]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(COUNT([race_id])) + &quot; races, 2010 to 2025&quot;' />
      </column>
      <column caption='Card Pole' datatype='string' name='[Calculation_6390757754474500]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(AVG([pole_won])*100,0)) + &quot;% won from pole&quot;' />
      </column>
      <column caption='Card Gain' datatype='string' name='[Calculation_6390757754523653]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([gain]) &gt;= 0 THEN &quot;+&quot; ELSE &quot;&quot; END + STR(ROUND(AVG([gain]),2)) + &quot; gain from the grid&quot;' />
      </column>
      <column caption='races.csv' datatype='table' name='[__tableau_internal_object_id__].[races.csv_7392A3FA1FF543EA8F1A9E7D7AF941A8]' role='measure' type='quantitative' />
      <column caption='Circuit Id' datatype='string' name='[circuit_id]' role='dimension' type='nominal' />
